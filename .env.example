MODEL_ENCRYPTION_KEY=
# Optional: keep the SQLite file outside the repository data directory.
DATABASE_PATH=./data/thought-incubator.db
# The dev server listens on 127.0.0.1 by default. Do not expose it to LAN casually.
ALLOW_LAN=0
